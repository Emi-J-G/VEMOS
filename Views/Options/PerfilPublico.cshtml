@model VEMOS.Models.Usuario

@{
    Layout = "_Layout";
    ViewData["Title"] = "Perfil público";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/perfil-publico.css" asp-append-version="true" />
}

<section class="profile-page public-profile-page" aria-labelledby="public-profile-title">
    <a class="profile-edit-link" href="/Options/Amigos">← Volver a amigos</a>
    <div class="profile-summary">
        @if (!string.IsNullOrWhiteSpace(Model.foto))
        {
            <img class="profile-avatar-large profile-avatar-photo" src="@Model.foto" alt="Foto de @Model.username" />
        }
        else
        {
            <div class="profile-avatar-large" aria-hidden="true">@Model.username.Trim()[0].ToString().ToUpperInvariant()</div>
        }
        <div class="profile-summary-copy">
            <p class="profile-kicker">Perfil público</p>
            <h1 id="public-profile-title">@Model.NombreCompleto</h1>
            <p class="profile-handle">@@@Model.username <span>• Cuenta @Model.tipo</span></p>
        </div>
        @if (ViewBag.EsAmigo is bool esAmigo && esAmigo)
        {
            <form class="profile-friend-hover-form" method="post" action="/Options/Amigos/Eliminar">
                <input type="hidden" name="idAmigo" value="@Model.id" />
                <button class="profile-friend-hover-button" type="submit">
                    <span class="profile-friend-label-default">Ya son amigos</span>
                    <span class="profile-friend-label-hover">Eliminar amigo</span>
                </button>
            </form>
        }
        else
        {
            <form method="post" action="/FamiliaAmigos/Agregar">
                <input type="hidden" name="identificador" value="@Model.username" />
                <button class="profile-edit-link" type="submit">Agregar como amigo</button>
            </form>
        }
        <form method="post" action="/Chat/EnviarMensaje">
            <input type="hidden" name="username" value="@Model.username" />
            <button class="profile-edit-link" type="submit">Enviar mensaje</button>
        </form>
    </div>

    <section class="profile-favorites-card public-profile-favorites" aria-labelledby="public-favorites-title">
        <div class="profile-section-heading">
            <div><p class="profile-kicker">Guardados</p><h2 id="public-favorites-title">Restaurantes favoritos</h2></div>
            <span class="profile-preferences-count">@((IEnumerable<VEMOS.Models.Restaurante>)ViewBag.RestaurantesFavoritos).Count()</span>
        </div>
        @if (((IEnumerable<VEMOS.Models.Restaurante>)ViewBag.RestaurantesFavoritos).Any())
        {
            <div class="profile-favorite-list">
                @foreach (VEMOS.Models.Restaurante favorito in (IEnumerable<VEMOS.Models.Restaurante>)ViewBag.RestaurantesFavoritos)
                {
                    <article class="profile-favorite-item">
                        <div>
                            <h3>@favorito.nombre</h3>
                            <p>@favorito.direccion • @favorito.tipo</p>
                        </div>
                        <a href="/Home/DetalleRestaurante?nombre=@Uri.EscapeDataString(favorito.nombre)">Ver ficha <span aria-hidden="true">→</span></a>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="profile-empty-preferences">Esta persona todavía no tiene restaurantes favoritos.</p>
        }
    </section>
</section>
