@model VEMOS.Models.ChatViewModel

@{
    ViewData["Title"] = "Mensajes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/chat.css" asp-append-version="true" />
}

<section class="chat-page">
    <aside class="chat-inbox">
        <div class="chat-inbox-heading">
            <p class="profile-kicker">Comunidad</p>
            <h1>Mensajes</h1>
        </div>

        @if (Model.Conversaciones.Any())
        {
            <div class="chat-conversation-list">
                @foreach (VEMOS.Models.ConversacionChatViewModel conversacion in Model.Conversaciones)
                {
                    <a class="chat-conversation @(conversacion.Activa ? "active" : "")" href="/Chat?idConversacion=@conversacion.Id">
                        <div class="chat-avatar">@conversacion.Inicial</div>
                        <div>
                            <strong>@conversacion.NombreUsuario</strong>
                            <span>@conversacion.UltimoMensaje</span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="chat-empty">Todavía no tenés conversaciones. Buscá un perfil y elegí “Enviar mensaje”.</p>
        }
    </aside>

    <section class="chat-window" aria-label="Conversación">
        @if (Model.HayConversacionSeleccionada)
        {
            <header class="chat-window-header">
                <div class="chat-avatar">@Model.InicialOtroUsuario</div>
                <div><strong>@Model.NombreOtroUsuario</strong><span>@@@Model.UsernameOtroUsuario</span></div>
                <a href="/Options/Usuarios/Perfil?username=@Uri.EscapeDataString(Model.UsernameOtroUsuario)">Ver perfil</a>
            </header>

            <div class="chat-messages" id="chat-messages" data-conversacion="@Model.ConversacionActiva" data-usuario="@Model.UsuarioActual">
                @if (Model.Mensajes.Any())
                {
                    @foreach (VEMOS.Models.MensajeChatViewModel mensaje in Model.Mensajes)
                    {
                        <div class="chat-message @(mensaje.Propio ? "own" : "")">
                            <p>@mensaje.Texto</p>
                            <time>@mensaje.Hora</time>
                        </div>
                    }
                }
                else
                {
                    <p class="chat-empty chat-empty-messages">Este chat está listo. Escribí el primer mensaje.</p>
                }
            </div>

            <form class="chat-compose" id="chat-compose" action="/Chat/Enviar" method="post">
                <input type="hidden" name="idConversacion" value="@Model.ConversacionActiva" />
                <label class="sr-only" for="chat-text">Mensaje</label>
                <input id="chat-text" name="texto" type="text" maxlength="1000" placeholder="Escribí un mensaje…" autocomplete="off" required />
                <button type="submit">Enviar</button>
            </form>
            <p id="chat-feedback" class="chat-feedback" hidden></p>
        }
        else
        {
            <div class="chat-no-selection">
                <img src="~/Logos/Msj.png" alt="" />
                <h2>Seleccioná una conversación</h2>
                <p>Podés conversar con cualquier usuario, aunque todavía no sean amigos.</p>
            </div>
        }
    </section>
</section>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
