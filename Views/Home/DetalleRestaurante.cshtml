@model VEMOS.Models.DetalleRestauranteViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Restaurante.nombre;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/detalle-restaurante.css" asp-append-version="true" />
}

<section class="restaurant-detail-shell">
    <div class="restaurant-detail-header">
        <a class="map-page-back" href="/Home/Mapa">← Volver al mapa</a>
    </div>

    <article class="restaurant-detail-card">
        <div class="restaurant-detail-hero">
            <div class="restaurant-detail-image">
                @if (string.IsNullOrWhiteSpace(Model.FotoUrl))
                {
                    <span class="restaurant-no-image">No hay imagen disponible</span>
                }
                else
                {
                    <img src="@Model.FotoUrl" alt="Exterior de @Model.Restaurante.nombre" onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
                    <span class="restaurant-no-image" hidden>No hay imagen disponible</span>
                }
                <span class="restaurant-detail-photo-tag">★ Recomendado por la comunidad</span>
            </div>
            <div class="restaurant-detail-hero-copy">
                <div class="restaurant-detail-badge">@Model.Restaurante.tipo</div>
                <h1>@Model.Restaurante.nombre</h1>
                <p>@Model.Restaurante.descripcion</p>
                <div class="restaurant-detail-meta"><span>@Model.Restaurante.tipo</span><span>•</span><span>@Model.Restaurante.direccion</span></div>
            </div>
        </div>

        <div class="restaurant-detail-content">
            <div class="restaurant-detail-info">
                <div class="detail-item"><span class="detail-label">Dirección</span><strong>@Model.Restaurante.direccion</strong></div>
                <div class="detail-item"><span class="detail-label">Teléfono</span><strong>@Model.Restaurante.telefono</strong></div>
                <div class="detail-item">
                    <span class="detail-label">Apto para</span>
                    <div class="detail-tags">
                        @if (Model.Restaurante.restricciones != null && Model.Restaurante.restricciones.Count > 0)
                        {
                            foreach (string restriccion in Model.Restaurante.restricciones)
                            {
                                <span class="detail-tag">@restriccion</span>
                            }
                        }
                        else
                        {
                            <span class="detail-tag">Sin restricciones específicas</span>
                        }
                    </div>
                </div>
                <div class="detail-item"><span class="detail-label">Horarios</span><strong>Lun a dom · 12:00 a 23:30</strong></div>
            </div>

            <div class="restaurant-detail-actions">
                <a class="restaurant-action-primary" href="/Home/Mapa">Ver en el mapa</a>
                <button type="button" class="restaurant-action-secondary" id="favorite-restaurant-button" data-restaurant-id="@Model.Restaurante.id">@Model.TextoFavorito</button>
            </div>
        </div>
    </article>

    <section class="restaurant-detail-section" aria-labelledby="restaurant-menu-title">
        <p class="profile-kicker">Una probadita</p>
        <h2 id="restaurant-menu-title">Platos destacados</h2>
        <p>Descubrí opciones que se adaptan a tus preferencias.</p>
        <div class="restaurant-dishes">
            <article><img src="~/Images/plato-3.png" alt="Plato destacado" /><strong>Bowls de temporada</strong><span>Sin TACC</span></article>
            <article><img src="~/Images/plato-1.png" alt="Plato destacado" /><strong>Ensalada fresca</strong><span>Vegetariano</span></article>
        </div>
    </section>

    <script>
        document.getElementById('favorite-restaurant-button')?.addEventListener('click', async function () {
            const response = await fetch('/Options/Favoritos/Toggle', {
                method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ idRestaurante: this.dataset.restaurantId })
            });
            if (!response.ok) return;
            const data = await response.json();
            this.textContent = data.favorito ? 'Quitar de favoritos' : 'Guardar favorito';
        });
    </script>
</section>
