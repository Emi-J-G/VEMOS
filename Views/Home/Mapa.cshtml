@model VEMOS.Models.MapaViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mapa";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <link rel="stylesheet" href="~/css/pages/mapa.css" asp-append-version="true" />
}

<section class="map-page-shell">
    <div class="map-page-header">
        <div>
            <p class="map-page-kicker">Explorá cerca tuyo</p>
            <h1>Mapa de restaurantes</h1>
        </div>
        <a class="map-page-back" href="/Home/Home">← Volver al inicio</a>
    </div>

    <div class="map-panel">
        <div class="map-panel-toolbar">
            <div class="map-search-wrap">
                <span aria-hidden="true"><img src="~/Logos/busqueda.png" alt="Buscar" /></span>
                <input id="mapSearch" type="text" placeholder="Buscar ubicación o restaurante" aria-label="Buscar ubicación o restaurante" />
            </div>
            <button type="button" id="locateBtn" class="map-locate-btn">Mi ubicación</button>
        </div>

        <div class="map-filter-bar">
            <div class="map-filter-header">
                <strong>Filtrar por restricciones</strong>
                <span id="mapFilterSummary">@Model.CantidadRestriccionesActivas activas</span>
            </div>

            <div class="map-filter-list" id="mapFilterList">
                @foreach (MapaFiltroViewModel filtro in Model.Filtros)
                {
                    <label class="map-filter-option">
                        <input type="checkbox" value="@filtro.Nombre" checked="@filtro.Activo" class="map-filter-checkbox" />
                        <span>@filtro.Nombre</span>
                    </label>
                }
            </div>
        </div>

        <div id="map"
             aria-label="Mapa de restaurantes"
             data-restaurantes="@Model.RestaurantesJson"
             data-restricciones-usuario="@Model.RestriccionesUsuarioJson"
             data-restricciones-todos="@Model.RestriccionesTodosJson"></div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="~/js/mapa.js" asp-append-version="true"></script>
}
