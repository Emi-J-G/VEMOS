@model IEnumerable<VEMOS.Models.Restaurante>
@{
    ViewData["Title"] = "Buscar";
    var query = ViewBag.Query as string ?? string.Empty;
    var filtro = ViewBag.Filtro as string ?? string.Empty;
}

<section class="search-page" aria-labelledby="search-title">
    <div class="search-page-header">
        <div>
            <p class="profile-kicker">Descubrí algo nuevo</p>
            <h1 id="search-title">Buscá restaurantes y platos</h1>
            <p>Encontrá opciones que se adapten a vos y a quienes te acompañan.</p>
        </div>
        <img src="~/Logos/busqueda.png" alt="" aria-hidden="true" />
    </div>

    <form class="search-page-form" action="/Buscar" method="get" role="search">
        <img src="~/Logos/busqueda.png" alt="" aria-hidden="true" />
        <input type="search" name="q" value="@query" placeholder="Buscar por nombre, barrio o plato..." aria-label="Buscar por nombre, barrio o plato" autofocus />
        <button type="submit">Buscar</button>
    </form>

    <div class="search-page-toolbar">
        <strong>@(string.IsNullOrWhiteSpace(query) ? "Lugares para descubrir" : $"Resultados para “{query}”")</strong>
        <div class="search-page-filters"><button type="button" class="is-active">Todos</button><button type="button">Sin TACC</button><button type="button">Vegetariano</button><button type="button">Favoritos</button></div>
    </div>

    <div class="search-results-grid">
        @foreach (var restaurante in Model ?? Enumerable.Empty<VEMOS.Models.Restaurante>())
        {
            var foto = restaurante.foto?.Trim();
            var fotoUrl = string.IsNullOrWhiteSpace(foto)
                ? string.Empty
                : (foto.StartsWith("/", StringComparison.Ordinal) || foto.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                    ? foto
                    : Url.Content($"~/Images/{foto}"));
            <article class="search-result-card">
                <div class="search-result-image">
                    @if (string.IsNullOrWhiteSpace(fotoUrl))
                    {
                        <span class="restaurant-no-image">No hay imagen disponible</span>
                    }
                    else
                    {
                        <img src="@fotoUrl" alt="Interior de @restaurante.nombre" onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
                        <span class="restaurant-no-image" hidden>No hay imagen disponible</span>
                    }
                </div>
                <div class="search-result-body">
                    <p class="search-result-type">@restaurante.tipo · @restaurante.direccion</p>
                    <h2>@restaurante.nombre</h2>
                    <p>@restaurante.descripcion</p>
                    <div>
                        @foreach (var restriccion in restaurante.restricciones ?? Enumerable.Empty<string>())
                        {
                            <span>@restriccion</span>
                        }
                    </div>
                    <a href="/Home/DetalleRestaurante?nombre=@Uri.EscapeDataString(restaurante.nombre)">Ver ficha →</a>
                </div>
            </article>
        }
    </div>
</section>
