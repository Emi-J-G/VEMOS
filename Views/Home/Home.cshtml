@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";

    var filtrosActivos = ViewBag.filtrosActivos as IEnumerable<Restriccion> ?? new List<Restriccion>();
    var platosFavoritos = ViewBag.PlatosFavoritos as IEnumerable<Plato> ?? Enumerable.Empty<Plato>();
    var restaurantesFavoritos = ViewBag.RestaurantesFavoritos as IEnumerable<Restaurante> ?? Enumerable.Empty<Restaurante>();
    var hayFavoritos = ViewBag.HayFavoritos as bool? ?? false;

    var todasRestricciones = new[]
    {
        "Celiaquía",
        "Diabetes",
        "Kosher",
        "Halal",
        "Lactosa",
        "Vegano",
        "Vegetariano",
        "Alergias"
    };

    var filtrosActivosNombres = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var filtro in filtrosActivos)
    {
        if (!string.IsNullOrWhiteSpace(filtro.nombre))
        {
            filtrosActivosNombres.Add(filtro.nombre.Trim());
        }
    }

    var tituloFavoritos = platosFavoritos.Any() ? "Tus platos favoritos" : (restaurantesFavoritos.Any() ? "Tus restaurantes favoritos" : "Sin favoritos");
}

<section class="signed-home-hero" aria-labelledby="signed-home-title">
    <div class="signed-home-copy">
        <div class="signed-home-badge">
            <span aria-hidden="true">✦</span>
            <span>Tu espacio personal</span>
        </div>

        <h1 id="signed-home-title">¿Dónde querés<br />comer hoy?</h1>

        <p class="signed-home-description">
            Descubrí opciones gastronómicas usando tus preferencias<br class="desktop-only" />
            alimentarias y elegí dónde salir.
        </p>

        <div class="active-filters">
            <strong>Tus filtros activos</strong>
            <div class="filter-chips">
                @foreach (Restriccion restriccion in filtrosActivos)
                {
                    <span class="filter-chip"><span aria-hidden="true">✓</span> @restriccion.nombre</span>
                }
                @if (filtrosActivos.Count() == 0)
                {
                    <span class="filter-chip"><span aria-hidden="true">✓</span> Sin filtros activos</span>
                }
                <button type="button" class="edit-filters" id="edit-filters-button" aria-expanded="false" aria-controls="filter-editor-panel">
                    <span aria-hidden="true">☷</span> Editar filtros
                </button>
            </div>

            <div class="filter-editor-panel" id="filter-editor-panel" aria-hidden="true" hidden>
                <div class="filter-editor-header">
                    <strong>Filtros</strong>
                </div>

                <div class="filter-editor-grid">
                    @foreach (var filtro in todasRestricciones)
                    {
                        var seleccionado = filtrosActivosNombres.Contains(filtro);
                        <button type="button"
                                class="filter-editor-option @(seleccionado ? "is-selected" : "")"
                                data-filter-name="@filtro"
                                aria-pressed="@(seleccionado ? "true" : "false")">
                            <span class="filter-editor-check" aria-hidden="true">@(seleccionado ? "✓" : "+")</span>
                            <span>@filtro</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="signed-home-actions">
            <a class="signed-home-primary" href="/Mapa">Explorar mapa <span aria-hidden="true">→</span></a>
            <a class="signed-home-secondary" href="/Favoritos">Mis favoritos</a>
        </div>
    </div>

    <div class="signed-home-map-column">
        <div class="signed-home-map-card">
            <div class="signed-home-map" aria-label="Vista previa del mapa de restaurantes">
                <div class="mini-map-grid" aria-hidden="true"></div>
                <div class="mini-map-road road-one" aria-hidden="true"></div>
                <div class="mini-map-road road-two" aria-hidden="true"></div>
                <div class="mini-map-road road-three" aria-hidden="true"></div>

                <div class="map-label"><span aria-hidden="true">▥</span> Mapa de restaurantes</div>
                <a class="map-open-button" href="/Mapa">Abrir mapa completo <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <div class="map-filter-note"><span aria-hidden="true">♧</span> Aplicá filtros desde el mapa</div>
    </div>
</section>

<section class="inspiration-section" aria-labelledby="favorites-section-title">
    <div class="section-heading inspiration-heading">
        <div>
            <h2 id="favorites-section-title">@tituloFavoritos</h2>
            <p>Acá aparecen tus favoritos guardados en la base de datos.</p>
        </div>
        <a class="section-link" href="/Mapa">Ir al mapa <span aria-hidden="true">→</span></a>
    </div>

    @if (hayFavoritos)
    {
        <div class="inspiration-cards">
            @if (platosFavoritos.Any())
            {
                foreach (var plato in platosFavoritos)
                {
                    var platoFoto = plato.foto?.Trim();
                    var platoFotoUrl = string.IsNullOrWhiteSpace(platoFoto)
                        ? string.Empty
                        : (platoFoto.StartsWith("/", StringComparison.Ordinal) || platoFoto.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? platoFoto
                            : Url.Content($"~/Images/{platoFoto}"));

                    <article class="inspiration-card">
                        <div class="inspiration-image @(string.IsNullOrWhiteSpace(platoFotoUrl) ? "inspiration-no-image" : "")">
                            @if (!string.IsNullOrWhiteSpace(platoFotoUrl))
                            {
                                <img src="@platoFotoUrl" alt="@plato.nombre" onerror="this.hidden=true; this.parentElement.classList.add('inspiration-no-image'); this.parentElement.querySelector('.inspiration-no-image-text').hidden = false; this.nextElementSibling.hidden = true;" />
                                <span class="inspiration-no-image-text" hidden>No hay imagen disponible</span>
                                <span class="inspiration-image-badge">@plato.tipo</span>
                            }
                            else
                            {
                                <span class="inspiration-no-image-text">No hay imagen disponible</span>
                                <span class="inspiration-image-badge">@plato.tipo</span>
                            }
                        </div>
                        <h3>@plato.nombre</h3>
                        <p>@plato.descripcion</p>
                    </article>
                }
            }
            else
            {
                foreach (var restaurante in restaurantesFavoritos)
                {
                    var restauranteFoto = restaurante.foto?.Trim();
                    var restauranteFotoUrl = string.IsNullOrWhiteSpace(restauranteFoto)
                        ? string.Empty
                        : (restauranteFoto.StartsWith("/", StringComparison.Ordinal) || restauranteFoto.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? restauranteFoto
                            : Url.Content($"~/Images/{restauranteFoto}"));

                    <article class="inspiration-card">
                        <div class="inspiration-image @(string.IsNullOrWhiteSpace(restauranteFotoUrl) ? "inspiration-no-image" : "")">
                            @if (!string.IsNullOrWhiteSpace(restauranteFotoUrl))
                            {
                                <img src="@restauranteFotoUrl" alt="@restaurante.nombre" onerror="this.hidden=true; this.parentElement.classList.add('inspiration-no-image'); this.parentElement.querySelector('.inspiration-no-image-text').hidden = false; this.nextElementSibling.hidden = true;" />
                                <span class="inspiration-no-image-text" hidden>No hay imagen disponible</span>
                                <span class="inspiration-image-badge">@restaurante.tipo</span>
                            }
                            else
                            {
                                <span class="inspiration-no-image-text">No hay imagen disponible</span>
                                <span class="inspiration-image-badge">@restaurante.tipo</span>
                            }
                        </div>
                        <h3>@restaurante.nombre</h3>
                        <p>@restaurante.direccion</p>
                    </article>
                }
            }
        </div>
    }
    else
    {
        <div class="community-card" style="max-width: 760px; margin-top: 1rem;">
            <div class="community-icon" aria-hidden="true">♡</div>
            <div class="community-card-content">
                <h3>No tenés favoritos registrados</h3>
                <p>Guardá tus primeros platos o restaurantes para que aparezcan acá y puedas volver rápido a ellos.</p>
                <a href="/Mapa">Ir al mapa para registrar mis primeros favoritos <span aria-hidden="true">→</span></a>
            </div>
        </div>
    }
</section>

<section class="quick-access-section" aria-labelledby="quick-access-title">
    <div class="section-heading quick-access-heading">
        <div>
            <h2 id="quick-access-title">Tus accesos rápidos</h2>
            <p>Todo lo que necesitás a pocos clics.</p>
        </div>
    </div>

    <div class="quick-access-grid">
        <a class="quick-access-card quick-access-card-primary" href="/Mapa">
            <span class="quick-access-icon" aria-hidden="true">⌑</span>
            <span><strong>Abrir el mapa</strong><small>Explorá lugares cerca tuyo.</small></span>
        </a>
        <a class="quick-access-card" href="/Buscar?filtro=favoritos">
            <span class="quick-access-icon" aria-hidden="true">♡</span>
            <span><strong>Mis favoritos</strong><small>Volvé a los lugares que guardaste.</small></span>
        </a>
        <a class="quick-access-card" href="/Buscar">
            <span class="quick-access-icon" aria-hidden="true">☆</span>
            <span><strong>Reseñas</strong><small>Consultá experiencias compartidas.</small></span>
        </a>
        <a class="quick-access-card" href="/FamiliaAmigos">
            <span class="quick-access-icon" aria-hidden="true">♧</span>
            <span><strong>Familia y amigos</strong><small>Descubrí opciones para compartir.</small></span>
        </a>
    </div>
</section>

<section class="community-section" aria-labelledby="community-title">
    <div class="community-heading">
        <h2 id="community-title">Tu espacio en V.E.M.O.S.</h2>
        <p>Guardá lugares, consultá experiencias y compartí información con otras personas.</p>
    </div>

    <div class="community-cards">
        <article class="community-card">
            <div class="community-icon" aria-hidden="true">▯</div>
            <div class="community-card-content">
                <h3>Tus lugares guardados</h3>
                <p>Cuando marques un restaurante como favorito, vas a poder encontrarlo rápidamente desde acá.</p>
                <a href="/Buscar?filtro=favoritos">Ver mis favoritos <span aria-hidden="true">→</span></a>
            </div>
        </article>

        <article class="community-card">
            <div class="community-icon" aria-hidden="true">♧</div>
            <div class="community-card-content">
                <h3>Compartí tu experiencia</h3>
                <p>Leé reseñas de otros usuarios y ayudá a la comunidad compartiendo lo que encontraste.</p>
                <a href="/Buscar">Explorar lugares <span aria-hidden="true">→</span></a>
            </div>
        </article>
    </div>
</section>

<section class="safety-notice" aria-labelledby="safety-title">
    <div class="safety-icon" aria-hidden="true">♢</div>
    <div>
        <h2 id="safety-title">Antes de elegir, revisá la información</h2>
        <p>Los filtros y las reseñas ayudan a buscar. Si tenés alergias o celiaquía, confirmá siempre los ingredientes y la preparación con el restaurante.</p>
    </div>
</section>
