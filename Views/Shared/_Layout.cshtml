<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VEMOS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VEMOS.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var usuario = Context.Session.GetString("Usuario");
        var nombreCompleto = Context.Session.GetString("NombreCompleto");
        var inicialUsuario = !string.IsNullOrWhiteSpace(nombreCompleto)
            ? nombreCompleto.Trim()[0].ToString().ToUpperInvariant()
            : (!string.IsNullOrWhiteSpace(usuario)
                ? usuario.Trim()[0].ToString().ToUpperInvariant()
                : "U");
    }


    <header class="topbar">
        <div class="brand-wrap">
            <a href="/" class="brand-link" aria-label="Ir a inicio">
                <img src="~/Images/Logotipo.svg" alt="VEMOS" class="logo" />
            </a>


            <form class="search-form" action="/Buscar" method="get" role="search" data-search-page="/Buscar" aria-label="Abrir búsqueda">
                <span class="search-icon"><img src="~/Logos/busqueda.png" alt="Buscar" /></span>
                <input id="site-search" name="q" type="search" class="search-input" placeholder="Buscar restaurantes o platos" aria-label="Buscar restaurantes o platos" readonly onfocus="window.location.assign('/Buscar');" />
                <button type="submit" class="search-button" aria-label="Buscar"></button>
            </form>
            @if (!string.IsNullOrWhiteSpace(usuario))
            {
                <nav class="user-header-actions" aria-label="Navegación de usuario">
                    <a href="/Home/Home" class="header-nav-link header-home-link">
                        <img class="header-nav-icon" src="~/Logos/home.png" alt="" aria-hidden="true" />
                        <span>Inicio</span>
                    </a>
                    <a href="/Mapa" class="header-nav-link">
                        <img class="header-nav-icon" src="~/Logos/mapa.png" alt="" aria-hidden="true" />
                        <span>Mapa</span>
                    </a>
                    <a href="/Buscar" class="header-nav-link">
                        <img class="header-nav-icon" src="~/Logos/cubiertos.png" alt="" aria-hidden="true" />
                        <span>Restaurantes</span>
                    </a>
                    <a href="/Favoritos" class="header-nav-link">
                        <img class="header-nav-icon" src="~/Logos/estrellaFav.png" alt="" aria-hidden="true" />
                        <span>Favoritos</span>
                    </a>
                    <div class="profile-dropdown dropdown">
                        <button type="button" class="profile-button profile-dropdown-toggle dropdown-toggle" id="profileMenuButton" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Abrir menú de perfil">
                            <span class="profile-avatar">@inicialUsuario</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu" aria-labelledby="profileMenuButton">
                            <li><a class="dropdown-item" href="/Options/Perfil">Mi perfil</a></li>
                            <li><a class="dropdown-item" href="/Options/Ajustes">Ajustes</a></li>
                            <li><a class="dropdown-item" href="/FamiliaAmigos">Familia y Amigos</a></li>
                            <li><button type="button" class="dropdown-item auth-popup-trigger report-popup-trigger" data-auth-modal="report-modal">Reportar un problema</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="LoginRegis" asp-action="Logout" method="post" class="profile-logout-form">
                                    <button type="submit" class="dropdown-item profile-logout-button">Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </nav>
            }
            else
            {
                <nav class="auth-links" aria-label="Autenticación">
                    <div class="header-section-nav" aria-label="Navegación de secciones">
                        <a class="header-section-link" href="#inicio">Inicio</a>
                        <a class="header-section-link" href="#descubri">Descubrí</a>
                        <a class="header-section-link" href="#como-funciona">Cómo funciona</a>
                    </div>
                    <button type="button" class="auth-popup-trigger" data-auth-modal="register-modal">Registrarse</button>
                    <button type="button" class="auth-popup-trigger" data-auth-modal="login-modal">Iniciar sesión</button>
                </nav>
            }
        </div>
    </header>



    <div class="auth-modal-backdrop" id="report-modal" aria-hidden="true">
        <div class="auth-modal auth-modal-medium" role="dialog" aria-modal="true" aria-labelledby="report-title">
            <div class="login-card auth-modal-card report-card">
                <button type="button" class="auth-modal-close" aria-label="Cerrar">×</button>
                <h1 class="auth-title" id="report-title">Reportar un problema</h1>
                <p class="auth-message">Contanos qué está fallando para que podamos revisarlo.</p>
                <form class="login-form report-form" method="post" action="#" onsubmit="event.preventDefault();">
                    <label class="sr-only" for="report-category">Tipo de problema</label>
                    <select class="auth-select" id="report-category" name="tipoProblema" aria-label="Tipo de problema">
                        <option value="">Tipo de problema</option>
                        <option value="Error visual">Error visual</option>
                        <option value="Bug funcional">Bug funcional</option>
                        <option value="Contenido incorrecto">Contenido incorrecto</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <label class="sr-only" for="report-description">Descripción</label>
                    <textarea class="auth-input auth-textarea" id="report-description" name="descripcion" rows="5" placeholder="Describe el problema" required></textarea>
                    <button class="auth-submit" type="submit">Enviar reporte</button>
                </form>
            </div>
        </div>
    </div>

    <main role="main" class="page-main">
        @RenderBody()
    </main>


    <footer class="site-footer">
        <div class="footer-main">
            <div class="footer-brand">
                <img src="~/Images/Logotipo2.svg" alt="VEMOS" class="footer-logo" />
                <p>Todos los lugares. Todas las<br />personas.</p>
                <div class="footer-socials" aria-label="Redes sociales">
                    <a href="#" aria-label="Instagram">◎</a>
                    <a href="#" aria-label="Facebook">f</a>
                    <a href="#" aria-label="X">X</a>
                    <a href="#" aria-label="YouTube">▶</a>
                </div>
            </div>


            <div class="footer-columns">
                <div>
                    <h4>Navegación</h4>
                    <ul>
                        <li><a href="/#inicio">Inicio</a></li>
                        <li><a href="/#descubri">Descubrí</a></li>
                        <li><a href="/#como-funciona">Cómo funciona</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Restricciones</h4>
                    <ul>
                        <li><a href="#">Sin Gluten</a></li>
                        <li><a href="#">Intolerancias</a></li>
                        <li><a href="#">Alergias</a></li>
                        <li><a href="#">Religiosos</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Comunidad</h4>
                    <ul>
                        <li><a href="#">Instagram</a></li>
                        <li><a href="#">TikTok</a></li>
                        <li><a href="#">Mail</a></li>
                        <li><a href="#">WhatsApp</a></li>
                    </ul>
                </div>
            </div>


            <form class="footer-signup" id="footer-register-form" action="#" method="post" data-register-url='@Url.Action("Index", "Home")'>
                <h4>¡Móntate al día!</h4>
                <p>Ingresá tu correo y empezá a crear tu cuenta en V.E.M.O.S.</p>
                <label class="sr-only" for="footer-email">Tu correo electrónico</label>
                <input id="footer-email" name="email" type="email" placeholder="✉  Tu correo electrónico" autocomplete="email" inputmode="email" maxlength="254" pattern="[^\s@@]+@@[^\s@@]+\.[A-Za-z]{2,}" title="Ingresá un correo válido, por ejemplo nombre@gmail.com" required />
                <button type="submit">Suscribirse</button>
            </form>
        </div>


        <div class="footer-bottom">
            <span>© 2025 VEMOS</span>
            <span>Todos los derechos reservados</span>
            <nav aria-label="Enlaces legales">
                <a href="#">Accesibilidad</a>
                <a href="#">Cookies</a>
                <a href="#">Privacidad</a>
            </nav>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/vemos-registro-acceso.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
